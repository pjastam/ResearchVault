# macOS systeembestanden
.DS_Store
**/.DS_Store

# Obsidian-instellingen (machine-specifiek, niet deelbaar)
.obsidian/

# Claude Code lokale instellingen (bevatten persoonlijke paden en IDs)
.claude/settings.local.json
.claude/*.local.md

# NB: persoonlijke onderzoeksinhoud leeft nu in vault/ (zie vault/.gitignore) en
# authoring/ (echte map met per-item symlinks → Proton-app-map / repos) — de oude platte
# root-dirs (notes/, daily/, craft/, projects/) zijn met de raw/→olw→wiki/-migratie verdwenen.

# Feedreader — gegenereerde output en persoonlijke leesgeschiedenis
.claude/score_log.jsonl
.claude/skip_queue.jsonl
.claude/read_queue.jsonl
.claude/transcript_cache/
.claude/article_cache/

# PURE cache — gedeelde directory, niet in git
.claude/pure_cache/

# Back-catalog scout — runtime state (per-machine, niet deelbaar)
.claude/backfill_state.json

# Model-bake-off — werk in uitvoering rond een nog niet genomen beslissing.
# De scripts, bundelselectie en resultaten zijn wegwerp en verdwijnen na afloop.
# UITZONDERING BIJ HET OPRUIMEN: `equivalenties.toml` is géén testartefact maar
# domeinkennis (selectie-taxonomie, NL↔EN-equivalenties, canon-beslissingen en nog uit
# te voeren canon-correcties). Die verhuist naar een blijvende plek in plaats van mee de
# prullenbak in. Zolang deze regel geldt zit de map in geen enkele backuplaag —
# proton-backup.sh synct uit .claude/ alleen *.jsonl + feedreader-list.txt.
.claude/bakeoff/

# olw werkmap (runtime/experimenten, niet deelbaar)
.olw/

# Eenmalige hulpscripts — lokaal bewaren tot niet meer nodig, dan verwijderen
.claude/pure-backlog.py

# Python cache
**/__pycache__/
**/*.pyc

# OPML-exports (persoonlijke abonnementsdata, al verwerkt in feedreader-list.txt)
*.opml

# Syncthing configuratie (lokaal, apparaat-specifiek)
.stignore

# Laat lege mappen zichtbaar via .gitkeep (zie per map)
.env

# Harness-scratch: git-worktrees en subagent-werkmappen (nooit committen)
.claude/worktrees/
.superpowers/
