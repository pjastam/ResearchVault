# vault/-interne ignore. Inhoud niet in git (broninhoud + gegenereerde wiki),
# structuur wél via .gitkeep. Granulair sinds integratie-branch (was blanket
# raw//wiki//.cache/): zo blijven de submappen zichtbaar in git.

# raw/ = canonical Zotero-bundels + eigen-denkwerk-snapshots (raw/notes/) — broninhoud
raw/*
!raw/.gitkeep
!raw/notes/
raw/notes/*
!raw/notes/.gitkeep
!raw/annotations/
raw/annotations/*
!raw/annotations/.gitkeep

# wiki/ = olw-gegenereerd — inhoud niet delen, submap-structuur wél bewaren
wiki/*
!wiki/sources/
wiki/sources/*
!wiki/sources/.gitkeep
!wiki/syntheses/
wiki/syntheses/*
!wiki/syntheses/.gitkeep
!wiki/.drafts/
wiki/.drafts/*
!wiki/.drafts/.gitkeep

# canon/ = terminologische canon van DEZE instance (NL↔EN-equivalenties, begrips-
# taxonomieën, canon-beslissingen). Persoonlijke domeinoordelen, geen systeemcode —
# hoort dus bij de instance-inhoud en niet in een repo die anderen klonen.
# Onder backup via proton-backup.sh (eigen rclone-regel), net als raw/ en wiki/.
canon/*
!canon/.gitkeep

# volledig buiten git
.cache/
.olw/
authoring

# transiënte olw run-logs (compile/ingest stdout) — kunnen broninhoud bevatten
.olw-*.log

# dispatcher-logs (wiki_backend.py) — zelfde reden als .olw-*.log hierboven:
# subprocess-stdout van de backend, kan broninhoud bevatten. Deze repo is publiek.
.wiki-backend/
